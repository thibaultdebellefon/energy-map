# Secrets — never commit
.env

# Local data store — SQLite DB, raw USGS dumps (131 MB CSV), CSVs.
# All regenerated by the pipeline; never versioned.
data/*
!data/.gitkeep

# Pipeline logs
data-pipeline/*.log
app/public/launchd.*.log

# Python
__pycache__/
*.pyc
.venv/
venv/
.mypy_cache/
.pytest_cache/

# OS / editor
.DS_Store
.idea/
.vscode/
.gstack/

# The frontend now reads its data LIVE from Supabase — these JSON files are just
# local build artifacts, no longer served. world.geojson (base map) and vendor/
# stay committed (static assets Vercel serves).
app/public/data.json
app/public/news.json
app/public/prices.json
app/public/companies.json
