# Secrets — never commit
.env

# Local data store — SQLite DB, raw USGS dumps (131 MB CSV), CSVs.
# All regenerated by the pipeline; never versioned.
data/*
!data/.gitkeep
!data/port_cities.json

# Pipeline logs
data-pipeline/*.log
app/public/launchd.*.log

# Python
__pycache__/
*.pyc
.venv/
venv/
.mypy_cache/
.pytest_cache/

# OS / editor
.DS_Store
.idea/
.vscode/
.gstack/

# The frontend reads its data LIVE from Supabase — these JSON files are local
# build artifacts. world.geojson (base map) and vendor/ stay committed (static
# assets Vercel serves). data.json is kept committed as the map's offline
# fallback (boot() loads it when Supabase is unreachable), so it must ship in
# git-based Vercel deploys.
app/public/news.json
app/public/prices.json
app/public/companies.json
.vercel
