# Secrets — never commit
.env

# Local data store — SQLite DB, raw USGS dumps (131 MB CSV), CSVs.
# All regenerated by the pipeline; never versioned.
data/*
!data/.gitkeep

# Pipeline logs
data-pipeline/*.log
app/public/launchd.*.log

# Python
__pycache__/
*.pyc
.venv/
venv/
.mypy_cache/
.pytest_cache/

# OS / editor
.DS_Store
.idea/
.vscode/
.gstack/

# NOTE: app/public/*.json, world.geojson and vendor/ ARE committed on purpose —
# they are the static assets Vercel serves. news.json / prices.json are kept
# fresh by the GitHub Actions "Refresh data" workflow (.github/workflows).
